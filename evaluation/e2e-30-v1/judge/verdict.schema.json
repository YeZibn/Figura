{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Figura E2E-30 Codex verdict v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "batch_id",
    "verdict",
    "checks",
    "primary_failure",
    "secondary_failures",
    "artifact_refs",
    "quality_notes",
    "judge",
    "review_notes"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^(?:[ABC](?:0[1-9]|10)|K0[1-3])$"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "needs_review"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "critical",
          "status",
          "expected",
          "actual",
          "evidence",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "critical": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "unverifiable"
            ]
          },
          "expected": {},
          "actual": {},
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "contains": {
        "properties": {
          "critical": {
            "const": true
          }
        },
        "required": [
          "critical"
        ]
      }
    },
    "primary_failure": {
      "enum": [
        null,
        "structure_recognition",
        "data_extraction",
        "semantic_mapping",
        "requirement_omission",
        "history_override",
        "non_target_corruption",
        "baseline_construction",
        "rendering",
        "delivery",
        "delivery_ambiguous",
        "provider_system",
        "timeout",
        "evidence_missing",
        "reference_conflict",
        "protocol_anomaly"
      ]
    },
    "secondary_failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "prompt_version",
        "context_isolated",
        "actual_png_viewed",
        "limitations"
      ],
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_version": {
          "const": "1.0"
        },
        "context_isolated": {
          "type": "boolean"
        },
        "actual_png_viewed": {
          "type": "boolean"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "review_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "primary_failure": {
            "type": "null"
          },
          "checks": {
            "items": {
              "if": {
                "properties": {
                  "critical": {
                    "const": true
                  }
                }
              },
              "then": {
                "properties": {
                  "status": {
                    "const": "pass"
                  }
                }
              }
            }
          },
          "judge": {
            "properties": {
              "context_isolated": {
                "const": true
              },
              "actual_png_viewed": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "fail"
          }
        }
      },
      "then": {
        "properties": {
          "primary_failure": {
            "type": "string"
          },
          "checks": {
            "contains": {
              "properties": {
                "critical": {
                  "const": true
                },
                "status": {
                  "const": "fail"
                }
              },
              "required": [
                "critical",
                "status"
              ]
            }
          }
        }
      }
    }
  ]
}
