# Provider selection and provider-scoped credentials.
# Copy to `.env` and fill in real values. Never commit `.env`.
CHARTAGENT_PROVIDER=openai

OPENAI_API_KEY=
# Keep this pointed at the existing OpenAI-compatible relay used by the deployment.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=2

# Qwen uses the OpenAI-compatible DashScope endpoint. Thinking defaults to true.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
QWEN_TIMEOUT=60
QWEN_MAX_RETRIES=2
QWEN_ENABLE_THINKING=true

# Legacy aliases are Qwen-only lower-priority migration fallbacks. They never
# configure or override the OpenAI provider.
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASH_MODEL=qwen3.8-flash
