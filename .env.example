# Provider selection and provider-scoped credentials.
# Copy to `.env` and fill in real values. Never commit `.env`.
CHARTAGENT_PROVIDER=openai

# Durable local storage. The default is the project-local `.chartagent/`.
# Relative paths are resolved from the repository root. Set this explicitly to
# keep using a migrated store outside the repository.
# CHARTAGENT_DATA_DIR=.chartagent
# CHARTAGENT_ATTACHMENT_DIR=.chartagent/attachments

OPENAI_API_KEY=
# Keep this pointed at the existing OpenAI-compatible relay used by the deployment.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=2

# Qwen uses the OpenAI-compatible DashScope endpoint. Thinking defaults to true.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
QWEN_TIMEOUT=60
QWEN_MAX_RETRIES=2
QWEN_ENABLE_THINKING=true

# DeepSeek V4.1 Flash uses the OpenAI-compatible Chat Completions endpoint.
# The official API model ID is deepseek-flash; thinking defaults to enabled.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_ENABLE_THINKING=true
# Optional: low, high, or max.
# DEEPSEEK_REASONING_EFFORT=high

# Legacy aliases are Qwen-only lower-priority migration fallbacks. They never
# configure or override the OpenAI provider.
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASH_MODEL=qwen3.8-flash
