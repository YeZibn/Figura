{
  "name": "chartagent-desktop-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:gateway": "node scripts/dev-gateway.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config ../src-tauri/tauri.conf.json",
    "tauri:dev:gateway": "node scripts/tauri-dev-gateway.mjs",
    "tauri:info": "tauri info",
    "smoke": "node scripts/smoke.mjs && node scripts/launcher-smoke.mjs",
    "smoke:launcher": "node scripts/launcher-lifecycle-smoke.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
